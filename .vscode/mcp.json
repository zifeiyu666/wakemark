{
  "servers": {
    "wakemark": {
      "type": "http",
      "url": "http://localhost:3000/api/mcp",
      "headers": {
        "Authorization": "Bearer ${input:wakemarkApiKey}"
      }
    }
  },
  "inputs": [
    {
      "id": "wakemarkApiKey",
      "type": "promptString",
      "description": "WakeMark MCP API key (create one at Dashboard > MCP, starts with wkm_)",
      "password": true
    }
  ]
}
